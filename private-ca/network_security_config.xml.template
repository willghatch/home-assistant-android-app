<?xml version="1.0" encoding="utf-8"?>

<!--
  Generated by set-real-hass-cert.sh from private-ca/network_security_config.xml.template.
  Not tracked by git: edit the template and rerun the script instead of editing this file.
-->
<network-security-config>
    <!--
      Fork-local change: trust our own private CA for our own Home Assistant host only.

      The bundled CA in @raw/homelab_ca is an app-scoped trust anchor: it applies to this APK
      alone, unlike a CA installed through Android's settings, which every app on the device
      trusts. Scoping it to a <domain-config> narrows it further, so the private CA can only
      ever vouch for our own host and not for anything else this app talks to.

      Both OkHttp (see TLSHelper, which uses the platform default trust manager) and the WebView
      rendering the frontend honor this file, so no code change is needed.
    -->
    <domain-config>
        @DOMAIN_ELEMENTS@
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/homelab_ca"/>
        </trust-anchors>
    </domain-config>

    <!--
      Everything below is upstream's app/src/main/res/xml/network_security_config.xml (identical
      in :wear). The fork deletes that file, so if upstream ever changes it, a rebase stops on a
      modify/delete conflict: port the change here, then resolve by deleting the file again.
    -->
    <!-- We need to allow clear traffic for those who don't have SSL setup. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust preinstalled CAs -->
            <certificates src="system"/>
            <!-- Additionally trust user added CAs -->
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
